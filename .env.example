APP_NAME=IngredientIQ API
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1
FRONTEND_ORIGINS=["https://your-frontend.example"]

# Database values must be reachable from the API container.
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=ingredientiq_db
DB_USER=ingredientiq_user
DB_PASSWORD=replace_with_a_database_password

GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30

# Keep this secret stable across all API instances.
API_LIMIT_HASH_SECRET=replace_with_a_random_secret_of_at_least_32_characters
API_REQUESTS_PER_MINUTE=10
API_DAILY_ANALYSES_PER_IP=5
API_DAILY_SUBMISSIONS_PER_IP=100
API_DAILY_IMAGE_EXTRACTIONS_PER_IP=10
GATEWAY_PORT=8000