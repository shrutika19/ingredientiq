APP_NAME=IngredientIQ API
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
API_REQUESTS_PER_MINUTE=10
API_DAILY_ANALYSES_PER_IP=5
API_DAILY_SUBMISSIONS_PER_IP=100
# Set a random secret of at least 32 characters in production. Keep it stable
# across API instances and deployments so client quota keys remain consistent.
API_LIMIT_HASH_SECRET=replace_with_a_long_random_secret
# Include only proxy addresses or CIDRs that you control.
TRUSTED_PROXY_IPS=[]

FRONTEND_ORIGINS=["http://localhost:5173"]

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ingredientiq_db
DB_USER=ingredientiq_user
DB_PASSWORD=replace_with_local_password

# Gemini AI Configuration
GEMINI_API_KEY=your_actual_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30